# Server Runtime Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rota_dev?schema=public"

# Authentication & Cryptographic Secrets
JWT_ACCESS_SECRET="dev_access_secret_key_minimum_32_bytes_long_jwt_token"
JWT_REFRESH_SECRET="dev_refresh_secret_key_minimum_32_bytes_long_jwt_token"

# Cache & Distributed Locks (Redis)
REDIS_URL="redis://localhost:6379"

# Webhooks & Payment Gateway (Flutterwave Test Mode)
FLUTTERWAVE_SECRET_HASH="flw_secret_hash_test_mode"
