datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum ShiftStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
}

enum SwapStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PlanTier {
  STARTER
  TEAM
  BUSINESS
}

enum LedgerType {
  CHARGE
  CREDIT
  REFUND
}

// ---------------------------------------------------------
// CORE MULTI-TENANT & IDENTITY MODELS
// ---------------------------------------------------------

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  fullName           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships        Membership[]
  shifts             Shift[]
  sentSwapRequests   ShiftSwapRequest[] @relation("SwapRequester")
  targetedSwaps      ShiftSwapRequest[] @relation("SwapTarget")
  activities         Activity[]
  refreshTokens      RefreshToken[]
  deviceTokens       DeviceToken[]
  userSettings       UserSettings?

  @@map("users")
}

model Team {
  id                 String             @id @default(uuid())
  name               String
  industry           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships        Membership[]
  shifts             Shift[]
  activities         Activity[]
  subscription       Subscription?
  ledgerEntries      LedgerEntry[]

  @@map("teams")
}

model Membership {
  id                 String             @id @default(uuid())
  userId             String
  teamId             String
  role               Role
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team               Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------
// SHIFTS & SWAP MANAGEMENT
// ---------------------------------------------------------

model Shift {
  id                 String             @id @default(uuid())
  teamId             String
  userId             String
  roleTitle          String
  location           String
  startTime          DateTime
  endTime            DateTime
  status             ShiftStatus        @default(SCHEDULED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  team               Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  swapRequests       ShiftSwapRequest[]

  @@index([teamId, startTime])
  @@index([userId])
  @@map("shifts")
}

model ShiftSwapRequest {
  id                 String             @id @default(uuid())
  shiftId            String
  requesterId        String
  targetUserId       String?
  reason             String             @db.Text
  status             SwapStatus         @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  shift              Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requester          User               @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUser         User?              @relation("SwapTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([requesterId])
  @@index([targetUserId])
  @@map("shift_swap_requests")
}

// ---------------------------------------------------------
// ACTIVITY FEED (HIGH PERFORMANCE COMPOSITE CURSOR INDEX)
// ---------------------------------------------------------

model Activity {
  id                 String             @id @default(uuid())
  teamId             String
  actorId            String
  type               String
  description        String
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now())

  team               Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor              User               @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@map("activities")
}

// ---------------------------------------------------------
// BILLING, SUBSCRIPTIONS & FINANCIAL LEDGER
// ---------------------------------------------------------

model Subscription {
  id                 String             @id @default(uuid())
  teamId             String             @unique
  tier               PlanTier           @default(STARTER)
  seatCount          Int                @default(5)
  status             String             @default("active") // active | past_due
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  gracePeriodEnd     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  team               Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model LedgerEntry {
  id                 String             @id @default(uuid())
  teamId             String
  type               LedgerType
  amountCents        Int
  balanceAfterCents  Int
  description        String
  idempotencyKey     String             @unique
  createdAt          DateTime           @default(now())

  team               Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Rule: Directional append-only ledger; no update or delete operations allowed.
  @@index([teamId, createdAt(sort: Desc)])
  @@map("ledger_entries")
}

// ---------------------------------------------------------
// USER PREFERENCES & NOTIFICATION SETTINGS
// ---------------------------------------------------------

model UserSettings {
  id                 String             @id @default(uuid())
  userId             String             @unique
  quietHoursStart    String             @default("22:00")
  quietHoursEnd      String             @default("06:00")
  timezone           String             @default("Africa/Lagos")
  pushShiftChanges   Boolean            @default(true)
  pushSwapRequests   Boolean            @default(true)
  pushApprovals      Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ---------------------------------------------------------
// SECURITY, TOKENS & SESSIONS
// ---------------------------------------------------------

model RefreshToken {
  id                 String             @id @default(uuid())
  userId             String
  tokenHash          String             @unique
  isRevoked          Boolean            @default(false)
  familyId           String
  expiresAt          DateTime
  createdAt          DateTime           @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id                 String             @id @default(uuid())
  userId             String
  token              String
  platform           String             @default("android")
  createdAt          DateTime           @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}
